{
  "name": "eth-crypto-js",
  "version": "0.3.0",
  "description": "Cryptographic javascript-functions for ethereum and tutorials on how to use them together with web3js and solidity",
  "author": "Olivier Esuka <oesukan@gmail.com> (https://oesukam.me)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/oesukam/eth-crypto-js/issues"
  },
  "homepage": "https://github.com/oesukam/eth-crypto-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oesukam/eth-crypto-js.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.esm.js",
    "require": "./dist/index.js"
  },
  "files": [
    "./dist",
    "./src"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "blockchain",
    "crypto",
    "eth",
    "ethereum",
    "solidity",
    "evm",
    "identity",
    "key pair",
    "private key",
    "public key",
    "encryption",
    "secp256k1",
    "dapp",
    "ecies",
    "smart-contract",
    "signature"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "rollup --config rollup.config.mjs",
    "rimraf": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.{ts,js,json}\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "coveralls": "cat ./coverage/lcov.info | coveralls",
    "audit-ci": "audit-ci --config audit-ci.jsonc",
    "release": "npm publish --access-public"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.8",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "audit-ci": "^7.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.10",
    "rollup": "^4.60.0",
    "rollup-plugin-dts": "^6.1.1",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "tslib": "^2.6.3",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ethereum-cryptography": "^3.0.0"
  },
  "resolutions": {
    "flatted": "^3.4.2",
    "fast-uri": "^3.1.2"
  },
  "packageManager": "yarn@1.22.22"
}
